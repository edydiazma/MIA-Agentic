{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# API, WebSocket, webhooks (Meta, Stripe, CRM), script de tracking (/t) y salud → réplicas del backend.
	# /metrics NO se publica: Prometheus / CloudWatch lo leen dentro de la red de Docker.
	@backend path /api/* /ws /webhooks/* /hooks/* /t/* /w/* /v1/* /health /health/ready /docs /openapi.json
	handle @backend {
		reverse_proxy {
			# Todas las réplicas del servicio "backend" (DNS de Docker; se actualiza al escalar)
			dynamic a {
				name backend
				port 8000
				refresh 5s
			}
			lb_policy least_conn
			lb_retries 2
			lb_try_duration 5s
			# Chequeo pasivo: una réplica que falla se saca 30 s de la rotación
			fail_duration 30s
			max_fails 3
			unhealthy_status 502 503 504
		}
	}

	# Todo lo demás → panel (Next.js)
	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Subidas de archivos (recursos, catálogo, adjuntos) hasta 25 MB
	request_body {
		max_size 25MB
	}
}
