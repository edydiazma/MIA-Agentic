# ---- Dominio (DNS tipo A apuntando a la IP elástica de la EC2) ----
DOMAIN=panel.tuempresa.com
ACME_EMAIL=ti@tuempresa.com

# ---- Base de datos: Supabase "Session pooler" (puerto 5432, IPv4) ----
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
ORGANIZATION_ID=1

# ---- Supabase ----
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

# ---- Seguridad (genera con: openssl rand -hex 32) ----
JWT_SECRET=
ADMIN_EMAIL=admin@tuempresa.com
ADMIN_PASSWORD=

# ---- WhatsApp Cloud API ----
WA_API_VERSION=v23.0
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# ---- IA (conexiones "del servidor" del Cortex principal) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_MODEL=claude-opus-5-5
DEFAULT_EFFORT=low
TRANSCRIBE_MODEL=whisper-1

# ---- URLs públicas (callbacks OAuth, script de tracking, Stripe) ----
PUBLIC_BASE_URL=https://panel.tuempresa.com
FRONTEND_BASE_URL=https://panel.tuempresa.com

# ---- Atribución y conversiones ----
TRACKING_IP_SALT=                   # openssl rand -hex 16
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=       # MCC (opcional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_CAPI_TOKEN=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# ---- CRM ----
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# ---- SaaS y facturación ----
SAAS_SIGNUP_ENABLED=true
SAAS_TRIAL_DAYS=14
SAAS_DEFAULT_PLAN=professional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# ---- Voz (WebRTC) ----
# STUN/TURN separados por coma. El backend (agente de voz IA) y el navegador (softphone) usan los mismos.
VOICE_STUN_URLS=stun:stun.l.google.com:19302

# ---- Escala y operación (docs/data-model.md §12.1) ----
# Réplicas de la API (ROLE=api). El worker (ROLE=worker) es un servicio aparte del compose.
# Con agentes de voz IA activos usa 1 réplica (ver deploy/README.md → Voz).
BACKEND_REPLICAS=2
# pg: eventos en vivo entre réplicas por LISTEN/NOTIFY (requiere el Session pooler, no el Transaction pooler)
REALTIME_MODE=pg
# Si se define, /metrics exige "Authorization: Bearer <token>" (openssl rand -hex 24)
METRICS_TOKEN=
LOG_FORMAT=json
SENTRY_DSN=
APP_VERSION=

# ---- App del asesor (PWA): notificaciones Web Push ----
# Genera el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tuempresa.com
