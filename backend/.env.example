# --- Infra ---
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# DATABASE_URL=postgresql+asyncpg://wa:wa@localhost:5432/wa
MEDIA_DIR=./data/media
CORS_ORIGINS=http://localhost:3000

# --- Auth (cámbialos antes de exponer el servidor) ---
JWT_SECRET=pon-aqui-una-cadena-aleatoria-de-al-menos-32-caracteres
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# --- WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > API Setup) ---
WA_API_VERSION=v23.0
WA_PHONE_NUMBER_ID=
WA_WABA_ID=                 # WhatsApp Business Account ID: para listar plantillas y campañas
WA_ACCESS_TOKEN=            # token de System User permanente, no el temporal de 24 h
WA_APP_SECRET=              # App Settings > Basic > App Secret (valida la firma del webhook)
WA_VERIFY_TOKEN=elige-un-token-para-verificar-el-webhook

# --- Supabase (Dashboard > Connect / Project Settings > API Keys) ---
# DATABASE_URL: usa el "Session pooler" (puerto 5432); el host directo db.<ref>.supabase.co es solo IPv6
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=                # sb_secret_...  (solo backend, nunca en el frontend ni en el repo)
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- IA ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=             # también se usa para transcribir notas de voz
DEFAULT_PROVIDER=anthropic  # anthropic | openai (solo aplica al crear el primer bot)
DEFAULT_MODEL=claude-opus-5-5
DEFAULT_EFFORT=low
TRANSCRIBE_MODEL=whisper-1

# --- Comportamiento ---
DEBOUNCE_SECONDS=2.5
HISTORY_LIMIT=30
MAX_IMAGES_IN_CONTEXT=3
